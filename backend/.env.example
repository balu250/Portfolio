# Server Configuration
PORT=5000

# PostgreSQL Database Configuration
# Option A: Individual parameters (for local PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_NAME=portfolio_db
DB_SSL=false

# Option B: Complete Connection URL (recommended for cloud PostgreSQL like Neon, Supabase, Render, Railway)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Client URL (for CORS)
CLIENT_URL=http://localhost:5500

# Email Delivery Configuration (Web3Forms for direct email delivery to your inbox)
# Get free access key from https://web3forms.com
WEB3FORMS_ACCESS_KEY=9b1582fa-afed-4dea-9c27-012fa4f6c3eb
