# Server Configuration
PORT=5000

# PostgreSQL Database Configuration
# Option A: Individual parameters (for local PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=portfolio_db
DB_SSL=false

# Option B: Complete Connection URL (recommended for cloud PostgreSQL like Neon, Supabase, Render, Railway)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/portfolio_db

# Client URL (for CORS)
CLIENT_URL=http://localhost:5500
